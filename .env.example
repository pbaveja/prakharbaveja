NEXT_PUBLIC_SITE_URL=https://example.com

# Spotify (used by /spotify)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Studio (private article publishing at /studio)
STUDIO_PASSWORD=
STUDIO_SESSION_SECRET=
GITHUB_TOKEN=
GITHUB_REPO=pbaveja/prakharbaveja
GITHUB_BRANCH=main

# Database (Neon Postgres, set by the Vercel Neon integration)
DATABASE_URL=

# Commenter sign-in (Auth.js). Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Salt for hashed IPs / visitor ids. Generate with: openssl rand -hex 32
HASH_SECRET=
# Comma-separated "<provider>:<account id>" values that get the "Author" badge
ADMIN_USER_IDS=
# Protects /api/cron/prune-views (Vercel Cron sends it automatically)
CRON_SECRET=
